{
  "name": "@luisrodonccs/simplest-ui",
  "version": "0.1.0",
  "description": "Design system framework-agnostic: tokens CSS, layouts y Web Components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./components.js": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./components/accordion": {
      "types": "./dist/components/accordion.d.ts",
      "import": "./dist/accordion.js"
    },
    "./components/dropdown": {
      "types": "./dist/components/dropdown.d.ts",
      "import": "./dist/dropdown.js"
    },
    "./components/modal": {
      "types": "./dist/components/modal.d.ts",
      "import": "./dist/modal.js"
    },
    "./components/popover": {
      "types": "./dist/components/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./components/tabs": {
      "types": "./dist/components/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./components/toast": {
      "types": "./dist/components/toast.d.ts",
      "import": "./dist/toast.js"
    },
    "./components/tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "design-system",
    "web-components",
    "css",
    "framework-agnostic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuisRodOnCCS/simplest-ui.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/LuisRodOnCCS/simplest-ui#readme",
  "bugs": {
    "url": "https://github.com/LuisRodOnCCS/simplest-ui/issues"
  }
}
