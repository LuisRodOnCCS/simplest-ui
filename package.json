{
  "name": "@luisrodonccs/simplest-ui",
  "version": "0.1.0",
  "description": "Framework-agnostic design system with CSS tokens, layouts, and accessible Web Components.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./styles.css": "./dist/styles.css",
    "./components/accordion.css": "./dist/components/accordion.css",
    "./components/alert.css": "./dist/components/alert.css",
    "./components/avatar.css": "./dist/components/avatar.css",
    "./components/badge.css": "./dist/components/badge.css",
    "./components/button.css": "./dist/components/button.css",
    "./components/card.css": "./dist/components/card.css",
    "./components/checkbox.css": "./dist/components/checkbox.css",
    "./components/empty-state.css": "./dist/components/empty-state.css",
    "./components/input.css": "./dist/components/input.css",
    "./components/nav.css": "./dist/components/nav.css",
    "./components/popover.css": "./dist/components/popover.css",
    "./components/progress.css": "./dist/components/progress.css",
    "./components/radio.css": "./dist/components/radio.css",
    "./components/select.css": "./dist/components/select.css",
    "./components/skeleton.css": "./dist/components/skeleton.css",
    "./components/spinner.css": "./dist/components/spinner.css",
    "./components/stat.css": "./dist/components/stat.css",
    "./components/switch.css": "./dist/components/switch.css",
    "./components/table.css": "./dist/components/table.css",
    "./components/textarea.css": "./dist/components/textarea.css",
    "./components/toast.css": "./dist/components/toast.css",
    "./components/tooltip.css": "./dist/components/tooltip.css",
    "./components/topbar.css": "./dist/components/topbar.css",
    "./components.js": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./components/accordion": {
      "types": "./dist/components/accordion.d.ts",
      "import": "./dist/accordion.js"
    },
    "./components/dropdown": {
      "types": "./dist/components/dropdown.d.ts",
      "import": "./dist/dropdown.js"
    },
    "./components/drawer": {
      "types": "./dist/components/drawer.d.ts",
      "import": "./dist/drawer.js"
    },
    "./components/modal": {
      "types": "./dist/components/modal.d.ts",
      "import": "./dist/modal.js"
    },
    "./components/popover": {
      "types": "./dist/components/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./components/tabs": {
      "types": "./dist/components/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./components/toast": {
      "types": "./dist/components/toast.d.ts",
      "import": "./dist/toast.js"
    },
    "./components/tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "components.manifest.json"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.ts --open /docs/",
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.docs.json && tsc --noEmit -p tsconfig.e2e.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "catalog:generate": "node scripts/generate-catalogs.mjs",
    "catalog:check": "node scripts/check-catalogs.mjs",
    "test:consumer": "vite build --config tests/fixtures/laravel/vite.config.ts && vite build --config tests/fixtures/ssr/vite.config.ts",
    "docs:serve": "vite --config vite.docs.config.ts --host 127.0.0.1 --port 5173",
    "docs:dev": "vite --config vite.docs.config.ts --open /docs/",
    "docs:build": "npm run catalog:check && node scripts/verify-docs.mjs && vite build --config vite.docs.config.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "design-system",
    "web-components",
    "css",
    "framework-agnostic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuisRodOnCCS/simplest-ui.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/LuisRodOnCCS/simplest-ui#readme",
  "bugs": {
    "url": "https://github.com/LuisRodOnCCS/simplest-ui/issues"
  }
}
