{
  "name": "Simplest UI",
  "version": "0.2.1",
  "prefixes": { "customElement": "sui-", "cssClass": "ui-", "token": "--sui-" },
  "cssEntrypoints": {
    "tokens": "@luisrodonccs/simplest-ui/tokens.css",
    "reset": "@luisrodonccs/simplest-ui/reset.css",
    "base": "@luisrodonccs/simplest-ui/base.css",
    "components": "@luisrodonccs/simplest-ui/components.css",
    "all": "@luisrodonccs/simplest-ui/styles.css"
  },
  "webComponents": [
    { "tag": "sui-modal", "documentationId": "modal", "import": "@luisrodonccs/simplest-ui/components/modal", "className": "SuiModal", "attributes": ["open", "label", "close-label", "disable-backdrop-close"], "properties": { "open": "boolean", "label": "string", "closeLabel": "string", "disableBackdropClose": "boolean" }, "slots": ["title", "default", "footer"], "events": ["sui-open", "sui-close"], "eventDetails": { "sui-close": "{ reason: 'dismiss' | 'escape' | 'backdrop' | 'programmatic' }" }, "keyboard": ["Escape", "focus trap"] },
    { "tag": "sui-drawer", "documentationId": "drawer", "import": "@luisrodonccs/simplest-ui/components/drawer", "className": "SuiDrawer", "attributes": ["open", "label", "close-label", "disable-backdrop-close"], "properties": { "open": "boolean", "label": "string", "closeLabel": "string", "disableBackdropClose": "boolean" }, "slots": ["title", "default", "footer"], "events": ["sui-open", "sui-close"], "eventDetails": { "sui-close": "{ reason: 'dismiss' | 'escape' | 'backdrop' | 'programmatic' }" }, "keyboard": ["Escape", "focus trap"] },
    { "tag": "sui-dropdown", "documentationId": "dropdown", "import": "@luisrodonccs/simplest-ui/components/dropdown", "className": "SuiDropdown", "attributes": ["open"], "properties": { "open": "boolean" }, "slots": ["trigger", "default"], "events": ["sui-open", "sui-close", "sui-toggle", "sui-select"], "eventDetails": { "sui-select": "{ value: string }" }, "keyboard": ["ArrowUp", "ArrowDown", "Home", "End", "Enter", "Space", "Escape", "Tab"] },
    { "tag": "sui-tabs", "documentationId": "tabs", "import": "@luisrodonccs/simplest-ui/components/tabs", "className": "SuiTabs", "attributes": ["value", "variant"], "properties": { "value": "string", "variant": "'pill' | 'box'" }, "slots": ["default"], "events": ["sui-change"], "eventDetails": { "sui-change": "{ value: string }" }, "keyboard": ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"] },
    { "tag": "sui-accordion", "documentationId": "accordion", "import": "@luisrodonccs/simplest-ui/components/accordion", "className": "SuiAccordion", "attributes": ["multiple"], "properties": { "multiple": "boolean" }, "slots": ["default"], "events": ["sui-change"], "eventDetails": { "sui-change": "{ open: string[] }" }, "keyboard": ["ArrowUp", "ArrowDown", "Home", "End"] },
    { "tag": "sui-popover", "documentationId": "popover", "import": "@luisrodonccs/simplest-ui/components/popover", "className": "SuiPopover", "attributes": ["open", "label"], "properties": { "open": "boolean", "label": "string" }, "slots": ["trigger", "content"], "events": ["sui-open", "sui-close"], "keyboard": ["ArrowDown", "Enter", "Space", "Escape", "Tab"] },
    { "tag": "sui-tooltip", "documentationId": "tooltip", "import": "@luisrodonccs/simplest-ui/components/tooltip", "className": "SuiTooltip", "attributes": ["content"], "properties": { "content": "string" }, "slots": ["trigger", "content"], "events": [], "keyboard": ["focus"] },
    { "tag": "sui-toast", "documentationId": "toast", "import": "@luisrodonccs/simplest-ui/components/toast", "className": "SuiToast", "attributes": ["title", "message", "variant", "duration"], "properties": { "title": "string", "message": "string", "variant": "'default' | 'success' | 'warning' | 'danger'", "duration": "number" }, "slots": ["default"], "events": ["sui-dismiss"], "keyboard": [], "api": ["SuiToast.show({ title, message, variant, duration })"] }
  ],
  "cssComponents": [
    { "name": "button", "documentationId": "button", "classes": ["ui-button", "ui-button--primary", "ui-button--danger", "ui-button--ghost", "ui-button--sm"] },
    { "name": "input-field", "documentationId": "input-field", "classes": ["ui-field", "ui-label", "ui-help", "ui-error", "ui-input", "ui-input--invalid"] },
    { "name": "textarea", "documentationId": "textarea", "classes": ["ui-textarea", "ui-textarea--invalid"] },
    { "name": "select", "documentationId": "select", "classes": ["ui-select", "ui-select--invalid"] },
    { "name": "checkbox", "documentationId": "checkbox", "classes": ["ui-checkbox", "ui-checkbox--disabled"] },
    { "name": "radio", "documentationId": "radio", "classes": ["ui-radio", "ui-radio-group"] },
    { "name": "switch", "documentationId": "switch", "classes": ["ui-switch", "ui-switch__track"] },
    { "name": "card", "documentationId": "card", "classes": ["ui-card", "ui-card--raised", "ui-card--glass", "ui-card__header", "ui-card__title", "ui-card__body", "ui-card__footer"] },
    { "name": "badge-chip", "documentationId": "badge-chip", "classes": ["ui-badge", "ui-badge--primary", "ui-badge--success", "ui-badge--warning", "ui-badge--danger", "ui-badge--info", "ui-badge--outline", "ui-chip"] },
    { "name": "alert", "documentationId": "alert", "classes": ["ui-alert", "ui-alert--success", "ui-alert--warning", "ui-alert--danger", "ui-alert--info"] },
    { "name": "spinner", "documentationId": "spinner", "classes": ["ui-spinner", "ui-spinner--sm", "ui-spinner--lg"] },
    { "name": "skeleton", "documentationId": "skeleton", "classes": ["ui-skeleton", "ui-skeleton--text", "ui-skeleton--title", "ui-skeleton--avatar", "ui-skeleton--block"] },
    { "name": "progress", "documentationId": "progress", "classes": ["ui-progress", "ui-progress__bar", "ui-progress--indeterminate"] },
    { "name": "table", "documentationId": "table", "classes": ["ui-table-wrap", "ui-table"], "markup": "<div class=\"ui-table-wrap\" role=\"region\" aria-label=\"Users\" tabindex=\"0\">\n  <table class=\"ui-table\">\n    <caption class=\"sr-only\">Users</caption>\n    ...\n  </table>\n</div>", "required": ["The scroll container needs role=\"region\" and an accessible name", "tabindex=\"0\" keeps the horizontal scroll container reachable from the keyboard", "Give the table an accessible name; a caption, visible or visually hidden, is the preferred mechanism"], "recommended": ["Keep the caption and the region label consistent when both name the same content"] },
    { "name": "avatar", "documentationId": "avatar", "classes": ["ui-avatar", "ui-avatar--sm", "ui-avatar--lg", "ui-avatar-group"] },
    { "name": "stat", "documentationId": "stat", "classes": ["ui-stat", "ui-stat__label", "ui-stat__value", "ui-stat__hint"] },
    { "name": "empty-state", "documentationId": "empty-state", "classes": ["ui-empty", "ui-empty__title", "ui-empty__body"] },
    { "name": "nav", "documentationId": "nav", "classes": ["ui-nav", "ui-nav__item", "ui-nav__item--active", "ui-nav__group-title"] },
    { "name": "topbar", "documentationId": "topbar", "classes": ["ui-topbar", "ui-topbar__brand", "ui-topbar__mark", "ui-topbar__controls", "ui-topbar--glass"] }
  ],
  "layouts": [
    { "name": "container", "documentationId": "container", "classes": ["ui-container"] },
    { "name": "stack", "documentationId": "stack", "classes": ["ui-stack"] },
    { "name": "cluster", "documentationId": "cluster", "classes": ["ui-cluster"] },
    { "name": "grid", "documentationId": "grid", "classes": ["ui-grid", "ui-grid--auto"], "markup": "<div class=\"ui-grid ui-grid--auto\">\n  <article>One</article>\n  <article>Two</article>\n</div>", "required": ["Use ui-grid--auto when the column count must adapt to the viewport"], "recommended": ["Do not force a fixed column count for content that must reflow on narrow screens"] },
    { "name": "app-shell", "documentationId": "app-shell", "classes": ["ui-app-shell", "ui-app-shell--contained", "ui-app-shell__sidebar", "ui-app-shell__header", "ui-app-shell__main"] },
    { "name": "skip-link", "documentationId": "skip-link", "classes": ["ui-skip-link"], "markup": "<a class=\"ui-skip-link\" href=\"#main-content\">Skip to content</a>\n<main id=\"main-content\" tabindex=\"-1\">...</main>", "required": ["Place it as the first focusable element in the document", "Point href at the id of the main landmark", "Give the target tabindex=\"-1\" so activation transfers focus"], "recommended": ["Verify real sequential Tab navigation, visible focus and focus transfer in the supported engines", "If the target engine excludes links from its default Tab order, test whether an explicit tabindex=\"0\" is needed for that environment instead of treating it as a universal requirement"] }
  ],
  "pages": [
    { "name": "dashboard", "documentationId": "dashboard", "path": "docs/pages/dashboard.html" }
  ]
}
